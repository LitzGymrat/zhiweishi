deepseek_api_key=sk-your-deepseek-key
qwen_api_key=sk-your-qwen-key
access_password=change-this-before-public-use
PUBLIC_APP_MODE=poc1_readonly

# Optional local two-model chain. These endpoints run on the host GPU, not inside the app container.
# runtime_provider=local
# embedding_provider=local
# local_llm_base_url=http://host.docker.internal:8001/v1
# local_llm_model=finetuned
# local_llm_api_key=EMPTY
# local_embedding_base_url=http://host.docker.internal:8002/v1
# local_embedding_name=qwen3-embedding-0.6b
# local_embedding_api_key=EMPTY

# Optional defaults. Usually you do not need to modify these.
# deepseek_base_url=https://api.deepseek.com
# qwen_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# qwen_embedding_name=text-embedding-v4
