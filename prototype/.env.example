deepseek_api_key=sk-your-deepseek-key
deepseek_base_url=https://api.deepseek.com
model_name=deepseek-chat

# Runtime chain: online = DeepSeek + DashScope; local = LoRA vLLM + local embedding vLLM.
runtime_provider=online
local_llm_base_url=http://127.0.0.1:8001/v1
local_llm_model=finetuned
local_llm_api_key=EMPTY

# Optional: DMXAPI-compatible teacher model for SFT construction.
# The runtime app still uses the DeepSeek variables above.
dmx_api_key=your-dmxapi-key
dmx_base_url=https://www.dmxapi.cn/v1
dmx_model=gemini-3-flash-preview

# Optional OpenAI-compatible vision endpoint for image evidence extraction.
# Leave vision_base_url and vision_model blank to archive images without external vision calls.
vision_api_key=
vision_base_url=
vision_model=
vision_max_tokens=1024
vision_timeout_seconds=60
image_max_upload_mb=10
image_max_pixels=20000000

# Offline evaluation candidates. Base and finetuned endpoints are optional
# OpenAI-compatible local/model-serving interfaces; leave them blank as placeholders
# until the corresponding service is ready.
eval_base_base_url=
eval_base_model=
eval_base_api_key=
eval_finetuned_base_url=
eval_finetuned_model=
eval_finetuned_api_key=

qwen_api_key=sk-your-qwen-key
qwen_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
qwen_embedding_name=text-embedding-v4

embedding_provider=qwen
local_embedding_base_url=http://127.0.0.1:8002/v1
local_embedding_name=qwen3-embedding-0.6b
local_embedding_api_key=EMPTY
Chroma_persist_dir=./data/chroma_db
bm25_persist_dir=./data/bm25_index.json
chunk_size=500
chunk_overlap=80
top_k=6
app_mode=full
access_password=

# Local mode must use the Qwen3 embedding service; the index will rebuild automatically.
# runtime_provider=local
# embedding_provider=local
# Docker callers must use host.docker.internal rather than 127.0.0.1 for both local URLs.
# Optional: launch a read-only PoC1 experience.
# app_mode=poc1_readonly
# Optional: set a password before exposing the app to others.
# access_password=demo-2026
