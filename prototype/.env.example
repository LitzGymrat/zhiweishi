deepseek_api_key=sk-your-deepseek-key
deepseek_base_url=https://api.deepseek.com
model_name=deepseek-chat

qwen_api_key=sk-your-qwen-key
qwen_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
qwen_embedding_name=text-embedding-v4

embedding_provider=qwen
local_embedding_name=all-MiniLM-L6-v2
Chroma_persist_dir=./data/chroma_db
bm25_persist_dir=./data/bm25_index.json
chunk_size=500
chunk_overlap=80
top_k=6
app_mode=full
access_password=

# Optional: switch to local fallback embedding.
# embedding_provider=local
# Optional: launch a read-only PoC1 experience.
# app_mode=poc1_readonly
# Optional: set a password before exposing the app to others.
# access_password=demo-2026